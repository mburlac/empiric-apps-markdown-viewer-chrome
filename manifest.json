{
  "manifest_version": 3,
  "name": "Markdown Viewer",
  "version": "0.3.2",
  "description": "Render Markdown files as styled HTML with themes, syntax highlighting, TOC, Mermaid and KaTeX.",
  "author": "Empirica Apps",
  "homepage_url": "https://empiricapps.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle rendered Markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-view": {
      "description": "Toggle rendered / raw Markdown"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "run_at": "document_start",
      "js": ["src/content/early.js"],
      "css": ["src/content/early.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "run_at": "document_end",
      "js": ["vendor/marked.min.js", "vendor/dompurify.min.js", "vendor/highlight.min.js", "src/content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "vendor/**/*", "icons/*", "src/content/page-inject/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
